# 9AM9AM Bots — copy to .env and fill in. Never commit .env.
# Generate a session secret with: openssl rand -hex 32

# --- Required provider keys -------------------------------------------------
XAI_API_KEY=            # xAI console key; 9AM9AM Bots runs on grok-4.7
XAI_MODEL=grok-4.7
COMPOSIO_API_KEY=       # Composio project key (ak_...): sign-in, connectors, app marketplace
ORGO_API_KEY=           # Orgo key (sk_live_...) that can create computers in ORGO_WORKSPACE_ID
ORGO_WORKSPACE_ID=      # Orgo workspace holding every user's box
SESSION_SECRET=         # openssl rand -hex 32 (minimum 32 characters)

# --- Server ----------------------------------------------------------------
PORT=8787
APP_URL=http://localhost:5173     # where the web app is served (redirect target after sign-in)
SERVER_URL=http://localhost:8787  # public URL of this server (OAuth callbacks)
DEV_LOGIN=0             # 1 enables POST /api/auth/dev — local testing only, never in production
# COOKIE_SECURE=1       # force Secure cookies behind HTTPS (auto-detected from SERVER_URL)

# --- Orgo box size ---------------------------------------------------------
ORGO_RAM_GB=8           # 8 GB / 2 vCPU (Medium); 16/4 recommended for 4 active bots
ORGO_CPU=2
ORGO_RESOLUTION=1280x800x24

# --- Voice (optional; defaults shown) --------------------------------------
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_STT_MODEL=grok-voice-transcribe-2.0
