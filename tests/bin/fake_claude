#!/usr/bin/env python3
"""Faux `claude -p` pour les tests : plan JSON ou verdict, selon le prompt."""
import json
import os
import sys
import time

prompt = sys.argv[-1]
_real_print = print
_out = []


def print(*args):  # noqa: A001 — on capture pour imiter `--output-format json` si demandé
    _out.append(" ".join(str(a) for a in args))
if os.environ.get("FAKE_CLAUDE_ARGS"):
    with open(os.environ["FAKE_CLAUDE_ARGS"], "a", encoding="utf-8") as f:
        f.write(json.dumps(sys.argv[1:-1]) + "\n")
time.sleep(float(os.environ.get("FAKE_CEO_SLEEP", "0")))
if "Message de l'utilisateur" in prompt:
    n = int(os.environ.get("FAKE_CEO_TASKS", "2"))
    if os.environ.get("FAKE_CEO_CHAT") == "answer":
        print(json.dumps({"reply": "Oui, je suis Claude Code, le CEO.", "tasks": [], "conseil": {"modele": "Sonnet 5.5", "effort": "faible", "raison": "question simple"}}))
    else:
        print(json.dumps({"reply": "Je m'en occupe avec mon équipe.", "tasks": [
            {"title": f"Étape {i}", "worker": "opencode", "detail": f"faire l'étape {i}"}
            for i in range(1, n + 1)]}))
elif "Réponds directement à l'utilisateur" in prompt:
    print("Rapport du CEO : j'ai demandé à mon équipe de tout faire et j'ai vérifié chaque résultat.")
elif "Découpe l'objectif" in prompt:
    n = int(os.environ.get("FAKE_CEO_TASKS", "2"))
    print(json.dumps([{"title": f"Étape {i}", "worker": "opencode", "detail": f"faire l'étape {i}"}
                      for i in range(1, n + 1)]))
else:
    time.sleep(float(os.environ.get("FAKE_CEO_VERDICT_SLEEP", "0")))
    print(os.environ.get("FAKE_CEO_VERDICT", "VERDICT: ok") + "\nSuite : continuer.")

text = "\n".join(_out)
if "--output-format" in sys.argv and sys.argv[sys.argv.index("--output-format") + 1] == "json":
    # Enveloppe du vrai CLI : texte dans « result », consommation dans « usage ».
    _real_print(json.dumps({"type": "result", "is_error": False, "result": text,
                            "usage": {"input_tokens": 10, "cache_creation_input_tokens": 500,
                                      "cache_read_input_tokens": 6000, "output_tokens": 90}}))
else:
    _real_print(text)
