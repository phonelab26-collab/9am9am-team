#!/usr/bin/env python3
"""Faux `opencode` pour les tests, piloté par variables d'environnement."""
import json
import os
import subprocess
import sys
import time

args = sys.argv[1:]
if args[:1] == ["models"]:
    print("opencode/mimo-v2.6-flash-free\nopencode/big-pickle")
    sys.exit(0)
if args[:1] != ["run"]:
    print("usage : fake_opencode run -m M --format json PROMPT", file=sys.stderr)
    sys.exit(2)
prompt = args[-1]
title = next((ln[len("Ta tâche : "):] for ln in prompt.splitlines() if ln.startswith("Ta tâche : ")), "?")
if os.environ.get("FAKE_OC_LOG"):
    with open(os.environ["FAKE_OC_LOG"], "a", encoding="utf-8") as f:
        f.write(f"{os.getpid()}\t{title}\n")
if os.environ.get("FAKE_OC_GRANDCHILD"):
    g = subprocess.Popen(["sleep", "300"])
    with open(os.environ["FAKE_OC_GRANDCHILD"], "a", encoding="utf-8") as f:
        f.write(f"{g.pid}\n")
time.sleep(float(os.environ.get("FAKE_OC_SLEEP", "0")))
print(json.dumps({"type": "text", "sessionID": "ses_fake",
                  "part": {"type": "text", "text": f"fait : {title}"}}))
